# apps/api/.env  (committed — inside backend)
#
# ── DEVELOPMENT VALUES ─────────────────────────────────────────────────────
# Every value below targets a HOST run (`uvicorn app.main:app` from apps/api),
# with Postgres and Redis published on localhost. This is the dev preset.
#
# The Dockerfile bakes this file into the image, but overrides the two
# container-specific paths at runtime so images still work:
#     ENV HF_HOME=/app/.cache/huggingface
#     ENV CHROMA_PATH=/app/.chroma
# For a container deployment, swap POSTGRES_HOST / REDIS_URL to the service
# names (actilp-postgres / actilp-redis) — see README §4.

# ── DATABASE ───────────────────────────────────────────────────────────────
# DEV: Postgres published from Docker (docker run -p 5432:5432 ...) or install
POSTGRES_DB=actilp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── REDIS / CELERY ─────────────────────────────────────────────────────────
# DEV: Redis published from Docker (docker run -p 6379:6379 ...)
REDIS_URL=redis://localhost:6379/0
STREAM_NAME=actilp:raw_logs
STREAM_GROUP=actilp-workers

# ── AUTH ───────────────────────────────────────────────────────────────────
# DEV secret. Rotate this before any non-local deployment.
JWT_SECRET=dev-only-insecure-secret-do-not-ship
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7

# ── LOCAL CHROMADB ─────────────────────────────────────────────────────────
# DEV: relative to apps/api, matches .gitignore (.chroma/)
CHROMA_PATH=./.chroma

# ── QWEN2.5-0.5B + OUTLINES ────────────────────────────────────────────────
HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
HF_DEVICE=cpu
# DEV: reuse the shared Hugging Face cache on this machine.
# Use an ABSOLUTE path — HF libs do not expand "~" from this file.
# (Replace "shyhoon-moontaka" with $USER if you move the project.)
HF_HOME=/home/shyhoon-moontaka/.cache/huggingface
HF_MAX_NEW_TOKENS=512
# DEV: true = weights load at startup (slow boot, fast first parse)
HF_PRELOAD_ON_STARTUP=false

# ── EMBEDDER ───────────────────────────────────────────────────────────────
# Local sentence-transformers model, loaded in-process (no separate service).
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG TUNING ─────────────────────────────────────────────────────────────
# Retrieval window (documents). 10 is an unvalidated-safe default for a 0.5B
# model: docs past the nearest few add prompt cost with little relevance.
RAG_TOP_K=10
# Max characters of history in the prompt. 0 = built-in default (16_000).
RAG_CONTEXT_MAX_CHARS=0

# ── PROMPTS ────────────────────────────────────────────────────────────────
# DEV: blank = auto-detect <repo>/ml/prompts. Set an absolute path to pin it.
ML_PROMPT_DIR=

# ── APP ────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── BOOTSTRAP ADMIN ────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@actilp.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123!


